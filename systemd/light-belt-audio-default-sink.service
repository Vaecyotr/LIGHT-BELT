[Unit]
Description=LIGHT-BELT default audio sink (RT5616)
After=display-manager.service bluetooth.service
Wants=display-manager.service

[Service]
Type=oneshot
User=pi
Environment=HOME=/home/pi
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
ExecStart=/bin/bash /home/pi/LIGHT-BELT/scripts/deploy/rk3588/set-default-audio-sink.sh
RemainAfterExit=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
